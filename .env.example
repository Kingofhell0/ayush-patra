# Local development only. NEVER commit a real .env (it is git-ignored).
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ayush_portfolio

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
